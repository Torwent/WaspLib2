{$DEFINE WL_COMBAT_INCLUDED}
{$INCLUDE_ONCE WaspLib/osrs.simba}

type
  TRSCombat = record
    AttackStyles: TBoxArray;

    Boxes:record
      TopLeft,BottomLeft,TopRight,BottomRight,Category,CombatLvl, AutoRetaliate:TBox;
    end;
  end;

procedure TRSCombat.SetupGameTab();
begin
  with GameTab.TopLeft do
   Self.Boxes.TopLeft:= [X+567, Y+250, X+637, Y+296];

  with Gametab.topleft do
  Self.Boxes.TopRight:= [X+646,Y+250,X+716,Y+296];

  with Gametab.topleft do
  Self.Boxes.BottomLeft:=[X+567,Y+304,X+637,Y+350];

  with Gametab.topleft do
  Self.Boxes.BottomRight:= [X+646,Y+304,X+716,Y+350];

  with GameTab.TopLeft do
  Self.Boxes.CombatLvl:= [X+595,Y+230,X+686,Y+245];

  with GameTab.TopLeft do
  Self.Boxes.AutoRetaliate:= [X+567,Y+358,X+716,Y+401];

  with GameTab.TopLeft do
  Self.Boxes.Category:=[X+600,Y+441,X+685,Y+457];

  Self.AttackStyles :=[Self.boxes.topleft, Self.Boxes.TopRight,Self.Boxes.BottomLeft,  Self.Boxes.BottomRight];
end;

var
  Combat: TRSCombat;    
                                                                                         
