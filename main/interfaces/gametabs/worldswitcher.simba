(*
# WorldSwitcher
WorldSwitcher is resposible for changing worlds with the logged in world
switcher in the {ref}`Logout` gametab.
```{figure} ../../images/worldswitcher.png
```
*)
{$DEFINE WL_WORLDSWITCHER_INCLUDED}
{$INCLUDE_ONCE WaspLib/main.simba}

type
(*
## EWorldSwitcherButton enum
```pascal
EWorldSwitcherButton = enum(CONFIGURE, CLOSE, LOGOUT);
```
Enum representing the world switcher buttons.
*)
  EWorldSwitcherButton = enum(CONFIGURE, CLOSE, LOGOUT);

(*
## TWorld type
Helper record for {ref}`TworldSwitcher`.
*)
  TWorld = record
    Number: Integer;
    Bounds: TBox;
    Available: Boolean;
  end;

(*
## TWorldArray type
Helper type for {ref}`TworldSwitcher`.
*)
  TWorldArray = array of TWorld;

{$R-}
procedure ShowOnTarget(worlds: TWorldArray); overload;
var
  img: TImage;
  i: Integer;
begin
  img := Target.GetImage();


  for i := 0 to High(worlds) do
  begin
    WriteLn worlds[i].Number;
    if worlds[i].Available then
      img.DrawColor := $FFFFFF
    else
      img.DrawColor := $0000FF;
    img.DrawBox(worlds[i].Bounds);
  end;

  img.Show();
end;

type
(*
## TWorldSwitcher type
Main record that interacts with the {ref}`WorldSwitcher`.
*)
  TWorldSwitcher = record
    Scroll: TScrollBar;
    Cooldown: TCountDown;
    CurrentWorldBounds, SortArrow: TBox;
    Buttons: array [EWorldSwitcherButton] of TButton;
    const UNAVAILABLE: TColor = $7F7F7F;
    const F2P: TColor = $E0E0E0;
    const P2P: TColor = $00F0F0;
  end;

(*
## TWorldSwitcher.Setup
```pascal
procedure TWorldSwitcher.Setup();
```
Interal method used to setup the {ref}`TWorldSwitcher` cooldown.

This is automatically called for you on the {ref}`WorldSwitcher variable`.
*)
procedure TWorldSwitcher.Setup();
var
  t: Int64;
begin
  t := Time();
  Self.Cooldown.FLength := 8000;
  Self.Cooldown.FStartTime := t-8000;
  Self.Cooldown.FFinishTime := t;
  Self.Cooldown.FPauseTime := 0;
end;

(*
## TWorldSwitcher.SetupGameTab
```pascal
procedure TWorldSwitcher.SetupGameTab();
```
Interal method used to setup the {ref}`TWorldSwitcher` coordinates.

This is automatically called for you on the {ref}`WorldSwitcher variable`.
*)
procedure TWorldSwitcher.SetupGameTab();
begin
  with GameTab.Bounds do
  begin
    Self.CurrentWorldBounds := [X2-52, Y1+4, X2-25, Y1+17];

    Self.Buttons[EWorldSwitcherButton.CONFIGURE] := new TButton([X1, Y1+4, X1+15, Y1+19]);
    Self.Buttons[EWorldSwitcherButton.CLOSE] := new TButton([X2-17, Y1+2, X2+3, Y1+22]);
    Self.Buttons[EWorldSwitcherButton.LOGOUT] := new TButton([X2-19, Y2-30, X2+1, Y2-1]);

    Self.SortArrow := [X1+18, Y1+25, X1+34, Y1+35];
    Self.Scroll.Area := [X1-3, Y1+36, X2-13, Y2-33];
  end;

  Self.Scroll.Setup();
end;


function TWorldSwitcher._IsOpen(): Boolean;
begin
  Result := Target.HasColor([$0A0B0E, 5, EColorSpace.HSV, [0.368, 0.761, 1.873]], 90, Self.Buttons[EWorldSwitcherButton.CLOSE].Bounds);
end;

(*
## WorldSwitcher.IsOpen
```pascal
function TWorldSwitcher.IsOpen(): Boolean;
```
Returns true if the world switcher is open.

Example:
```pascal
WriteLn WorldSwitcher.IsOpen();
```
*)
function TWorldSwitcher.IsOpen(): Boolean;
begin
  Result := GameTabs.IsOpen(EGameTab.LOGOUT) and Self._IsOpen();
end;


(*
## WorldSwitcher.IsLoading
```pascal
function TWorldSwitcher.IsLoading(): Boolean;
```
Returns true if the world switcher is loading.
The world switcher takes a few milliseconds to load.

Example:
```pascal
WriteLn WorldSwitcher.IsLoading();
```
*)
function TWorldSwitcher.IsLoading(): Boolean;
begin
  Result := not Target.HasColor(TFonts.ORANGE, 0, 50, Self.CurrentWorldBounds);
end;

(*
## WorldSwitcher.WaitLoading
```pascal
function TWorldSwitcher.WaitLoading(time: Integer = 600; interval: Integer = -1): Boolean;
```
Waits for the world switcher to finish loading.
For more information on loading read {ref}`WorldSwitcher.IsLoading`.

Example:
```pascal
WriteLn WorldSwitcher.WaitLoading();
```
*)
function TWorldSwitcher.WaitLoading(time: Integer = 600; interval: Integer = -1): Boolean;
begin
  if interval < 0 then interval := RandomMode(100, 50, 1500);
  Result := SleepUntil(not Self.IsLoading(), interval, time);
end;

(*
## WorldSwitcher.Open
```pascal
function TWorldSwitcher.Open(waitLoad: Boolean = True): Boolean;
```
Attempts to open the world switcher.

This method is overriden after {ref}`Logout`, for more information check
{ref}`WorldSwitcher.Open override`.

Example:
```pascal
WriteLn WorldSwitcher.Open();
```
*)
function TWorldSwitcher.Open(waitLoad: Boolean = True): Boolean;
begin
  //overriden in TLogout.
  Result := SleepUntil(not Self._IsOpen(), RandomMode(100, 50, 1500), TICK);
  if Result and waitLoad then
    Self.WaitLoading(4*TICK);
end;



(*
## Logout.CloseWorldSwitcher
```pascal
function TLogout.CloseWorldSwitcher(): Boolean;
```
Closes the world switcher.

Example:
```pascal
Logout.CloseWorldSwitcher();
```
*)
function TWorldSwitcher.Close(): Boolean;
begin
  if not Self.IsOpen() then Exit(True);
  Self.Buttons[EWorldSwitcherButton.CLOSE].Click();
  Result := SleepUntil(not Self._IsOpen(), RandomMode(100, 50, 1500), 600);
end;

(*
## WorldSwitcher.Logout
```pascal
function TWorldSwitcher.Logout(attempts: UInt32 = 5; time: UInt32 = 20000): Boolean;
```
Clicks the logout button. Returns true if we succesfully logout of the game.

Example:
```pascal
WriteLn WorldSwitcher.Logout();
```
*)
function TWorldSwitcher.Logout(attempts: UInt32 = 5; time: UInt32 = 20000): Boolean;
var
  i: Integer;
  interval: UInt32;
begin
  if not Self.IsOpen() then Exit;
  interval := time div attempts;

  if Keyboard.LastKey = EKeyCode.RETURN then
    Keyboard.RandomKey();  //unlock enter if using remote input

  for i := 1 to attempts do
  begin
    Self.Buttons[EWorldSwitcherButton.LOGOUT].Click();
    if SleepUntil(not Client.IsLoggedIn(), 500, interval + Random(-2000, 2000)) then
      Exit(True);
  end;
end;


(*
## WorldSwitcher.GetWorlds
```pascal
function TWorldSwitcher.GetWorlds(): TWorldArray;
```
Returns the currently visible {ref}`TWorldArray`.

Example:
```pascal
ShowOnTarget(WorldSwitcher.Worlds);
```
*)
function TWorldSwitcher.GetWorlds(): TWorldArray;
var
  img: TImage;
  tpa0, tpa1: TPointArray;
  tmp, atpa: T2DPointArray;
  weights: TIntegerArray;
  world: TWorld;
  b, bounds: TBox;
  i, len, idx: Integer;
begin
  if not Self.IsOpen() then
    Exit;

  img := Target.GetImage(Self.Scroll.Area.Expand(0, 2));

  tpa0 := img.FindColor(TWorldSwitcher.F2P, 0) +
               img.FindColor(TWorldSwitcher.P2P, 0);

  atpa := tpa0.Cluster(5, 1.5);

  tpa1 := img.FindColor(TWorldSwitcher.UNAVAILABLE, 0);
  tmp := tpa1.Cluster(5, 1.5);
  atpa += tmp;

  img.Fill($0);
  img.DrawColor := $FFFFFF;
  img.DrawTPA(tpa0+tpa1);

  idx := High(atpa) - Length(tmp); //available index

  SetLength(weights, Length(atpa));
  SetLength(Result, Length(atpa));

  for i := 0 to High(atpa) do
  begin
    b := atpa[i].Bounds();
    if b.Height <> 10 then
      Continue;

    b.Y1 -= 2;
    b.Y2 += 2;

    bounds := [b.X1-3, b.Y1, b.X2+3, b.Y2];

    world.Number :=
      OCR.Engine.Recognize(img.Copy(bounds), Fonts.PLAIN_12).ExtractInteger();

    if world.Number = -1 then
      Continue;

    world.Available := i < idx;
    world.Bounds.X1 := Self.Scroll.Area.X1;
    world.Bounds.Y1 := Max(Self.Scroll.Area.Y1, Self.Scroll.Area.Y1 + b.Y1-2);
    world.Bounds.X2 := Self.Scroll.Area.X2;
    world.Bounds.Y2 := Min(Self.Scroll.Area.Y2, Self.Scroll.Area.Y1 + b.Y2 -1);

    weights[len] := b.Y1;
    Result[len] := world;
    Inc(len);
  end;

  SetLength(Result, len);
  SetLength(weights, len);

  Result.Sort(weights, True);
end;

(*
## WorldSwitcher.FindWorld
```pascal
function TWorldSwitcher.FindWorld(number: Integer; out world: TWorld): Boolean;
```
Returns true if the specified world `number` is found.
The world data is returned through the `world` variable.

Example:
```pascal
if WorldSwitcher.FindWorld(311, world) then
  ShowOnTarget([world]);
```
*)
function TWorldSwitcher.FindWorld(number: Integer; out world: TWorld): Boolean;
var
  img: TImage;
  available, unavailable: TPointArray;
  tmp, atpa: T2DPointArray;
  b, bounds: TBox;
  i, idx: Integer;
begin
  img := Target.GetImage(Self.Scroll.Area.Expand(0, 2));

  available := img.FindColor(TWorldSwitcher.F2P, 0) +
         img.FindColor(TWorldSwitcher.P2P, 0);

  atpa := available.Cluster(5, 1.5);

  unavailable := img.FindColor(TWorldSwitcher.UNAVAILABLE, 0);
  tmp := unavailable.Cluster(5, 1.5);
  atpa += tmp;

  img.Fill($0);
  img.DrawColor := $FFFFFF;
  img.DrawTPA(available+unavailable);

  idx := High(atpa) - Length(tmp);

  for i := 0 to High(atpa) do
  begin
    b := atpa[i].Bounds();
    if b.Height <> 10 then
      Continue;

    b.Y1 -= 2;
    b.Y2 += 2;

    bounds := [b.X1-3, b.Y1, b.X2+3, b.Y2];

    world.Number :=
      OCR.Engine.Recognize(img.Copy(bounds), Fonts.PLAIN_12).ExtractInteger();

    if world.Number <> number then
      Continue;

    world.Available := i < idx;
    world.Bounds.X1 := Self.Scroll.Area.X1;
    world.Bounds.Y1 := Max(Self.Scroll.Area.Y1, Self.Scroll.Area.Y1 + b.Y1-2);
    world.Bounds.X2 := Self.Scroll.Area.X2;
    world.Bounds.Y2 := Min(Self.Scroll.Area.Y2, Self.Scroll.Area.Y1 + b.Y2 -1);

    Exit(True);
  end;
end;


(*
## WorldSwitcher.IsSorted
```pascal
function TWorldSwitcher.IsSorted(): Boolean;
```
Checks if the worlds in the world switcher are sorted.

Example:
```pascal
WriteLn WorldSwitcher.IsSorted();
```
*)
function TWorldSwitcher.IsSorted(): Boolean;
var
  arrow : TPointArray;
begin
  arrow := Target.FindColor(
           ColorTolerance($0A5DA3, 0.781, EColorSpace.HSV, [2.366, 0.472, 0.164]),
           Self.SortArrow
         );
  Result := Self.SortArrow.Center = arrow.Mean();
end;

(*
## WorldSwitcher.Sort
```pascal
function TWorldSwitcher.Sort(): Boolean;
```
Sorts the worlds from lower to higher numbers.

Example:
```pascal
WriteLn WorldSwitcher.Sort();
```
*)
function TWorldSwitcher.Sort(): Boolean;
begin
  if not Self.IsOpen() then
    Exit;
  if Self.IsSorted() then
    Exit(True);
  Mouse.Click(Self.SortArrow, EMouseButton.LEFT);
  Result := SleepUntil(Self.IsSorted(), 50, 600);
end;

function TWorldSwitcher.WaitSwitch(world: Integer; failCooldown: Boolean = True): Boolean; forward;

function TWorldSwitcher._Hop(next: Integer): Boolean;
var
  timeout: TCountDown;
  worlds: TWorldArray;
  world: TWorld;
  profile: TProfile;
begin
  if not Self.IsSorted() and not Self.Sort() then
    Exit;

  timeout.Start(10*SECOND);

  repeat
    worlds := Self.GetWorlds();
    if worlds.IsEmpty then
      Exit;

    for world in worlds do
    begin
      if world.Number <> next then
        Continue;

      if not world.Available then
      begin
        DebugLn(
          'WorldSwitcher',
          'World ' + ToStr(next) + ' is unavailable.' + LINE_SEP +
          'It will be removed temporarily, but you should remove it in your profile!',
          ELogLevel.WARN
        );

        profile := Profiles.Get();
        profile.Worlds.Remove(next);
        profiles.Update(profile);
        Exit;
      end;

      Mouse.Click(world.Bounds, EMouseButton.LEFT);
      if Self.WaitSwitch(next) then
        Exit(True);
    end;

    if (worlds.First.Number < next) and (worlds.Last.Number > next) then
    begin
      DebugLn(
        'WorldSwitcher',
        'World ' + ToStr(next) + ' doesn''t exist.' + LINE_SEP +
        'It will be removed temporarily, but you should remove it in your profile!',
        ELogLevel.WARN
      );

      profile := Profiles.Get();
      profile.Worlds.Remove(next);
      profiles.Update(profile);
      Exit;
    end;

    Self.Scroll.Scroll(Biometrics.RandomModeInteger(2,1,3), next > worlds[0].Number);
  until not InRange(Self.Scroll.GetLevel(), 1, 99) or timeout.IsFinished;
end;

(*
## WorldSwitcher.World property
```pascal
property TWorldSwitcher.World: Integer;
property TWorldSwitcher.World(next: Integer): Boolean;
```
Returns or sets the current world we are on.

Setting a new world will only happen if `TWorldSwitcher.Cooldown` is finished,
which is a cooldown that starts everytime you change worlds.

Example:
```pascal
WriteLn WorldSwitcher.World;
WorldSwitcher.World := 311;
WriteLn WorldSwitcher.World;
```
*)
property TWorldSwitcher.World: Integer;
begin
  Result := OCR.RecognizeNumber(Self.CurrentWorldBounds, Fonts.BOLD, [TFonts.ORANGE], 0);
end;

property TWorldSwitcher.World(next: Integer): Boolean;
var
  current: Integer;
begin
  if not Self.Cooldown.IsFinished or not Self.Open() then
    Exit;
  current := Self.World;
  if next = current then
    Exit(True);
  Result := Self._Hop(next);
end;

(*
## WorldSwitcher.Next
```pascal
function TWorldSwitcher.Next(): Boolean;
```
Hops to the world that follows our current world according to the contents of
`Profiles.Get().Worlds`.

Example:
```pascal
WriteLn WorldSwitcher.World;
WorldSwitcher.Next();
WriteLn WorldSwitcher.World;
```
*)
function TWorldSwitcher.Next(): Boolean;
var
  profile: TProfile;
  current, next: Integer;
begin
  if not Self.Cooldown.IsFinished or not Self.Open() then
    Exit;

  profile := Profiles.Get();
  if profile.Worlds.IsEmpty then
    raise GetDebugLn('WorldSwitcher', 'Current profile has no worlds saved.');

  current := Self.World;
  if profile.Worlds = [current] then
    Exit(True);

  next := profile.Worlds.IndexOf(current);
  if Inc(next) > High(profile.Worlds) then
    next := 0;

  Result := Self._Hop(profile.Worlds[next]);
end;

(*
## WorldSwitcher.Previous
```pascal
function TWorldSwitcher.Previous(): Boolean;
```
Hops to the world that comes before our current world according to the contents
of `Profiles.Get().Worlds`.

Example:
```pascal
WriteLn WorldSwitcher.World;
WorldSwitcher.Previous();
WriteLn WorldSwitcher.World;
```
*)
function TWorldSwitcher.Previous(): Boolean;
var
  profile: TProfile;
  current, prev: Integer;
begin
  if not Self.Cooldown.IsFinished or not Self.Open() then
    Exit;

  profile := Profiles.Get();
  if profile.Worlds.IsEmpty then
    raise GetDebugLn('WorldSwitcher', 'Current profile has no worlds saved.');

  current := Self.World;
  if profile.Worlds = [current] then
    Exit(True);

  prev := profile.Worlds.IndexOf(current);
  if Dec(prev) < 0 then
    prev := High(profile.Worlds);

  Result := Self._Hop(profile.Worlds[prev]);
end;

(*
## WorldSwitcher.Random
```pascal
function TWorldSwitcher.Random(): Boolean;
```
Hops to a random world that's in `Profiles.Get().Worlds` and is not our
current world.

Example:
```pascal
WriteLn WorldSwitcher.World;
WorldSwitcher.Random();
WriteLn WorldSwitcher.World;
```
*)
function TWorldSwitcher.Random(): Boolean;
var
  profile: TProfile;
  current, rnd: Integer;
begin
  if not Self.Cooldown.IsFinished or not Self.Open() then
    Exit;

  profile := Profiles.Get();
  if profile.Worlds.IsEmpty then
    raise GetDebugLn('WorldSwitcher', 'Current profile has no worlds saved.');

  current := Self.World;
  if profile.Worlds = [current] then
    Exit(True);

  repeat
    rnd := profile.Worlds.Random();
  until rnd <> current;

  Result := Self._Hop(rnd);
end;


(*
## WorldSwitcher.WaitSwitch
```pascal
function TWorldSwitcher.WaitSwitch(world: Integer; failCooldown: Boolean = True): Boolean;
```
Exits false if "Please wait" not found, presumably due to combat.
Returns true if we find "Please wait" and finish world hopping successfully to
the specified `world`
*)
function TWorldSwitcher.WaitSwitch(world: Integer; failCooldown: Boolean = True): Boolean;
begin
  if not SleepUntil(MainScreen.IsServerMessage('Please wait'), 200, 3*TICK) then
  begin
    if failCooldown then
      Self.Cooldown.Restart(0, 7000);
    Exit;
  end;

  Result := SleepUntil(Self.World = world, 200, 10000);
end;
{$R+}

var
(*
## WorldSwitcher variable
Global {ref}`TWorldSwitcher` variable.
*)
  WorldSwitcher: TWorldSwitcher;
