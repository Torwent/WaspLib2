(*
# Music
Music is resposible for the track handling in the Music gametab.
```{figure} ../../images/music.png
```
*)

{$DEFINE WL_MUSIC_INCLUDED}
{$INCLUDE_ONCE WaspLib/main.simba}

type
(*
## EMusicButton
```pascal
EMusicButton = enum(AREA, MANUAL, RANDOM);
```
Enum representing the music configuration buttons.
*)
  EMusicButton = enum(AREA, MANUAL, RANDOM);

(*
## TMusic
Main record that interacts with the {ref}`Music` gametab.
*)
  TMusic = record
    Scroll: TScrollBar;
    Buttons: TButtonArray;
  end;

(*
## TMusicTrack
Helper record for {ref}`TMusic`.
*)
  TMusicTrack = record
    Name: String;
    Available: Boolean;
    Bounds: TBox;
  end;

(*
## TMusicTrackArray
Helper type for {ref}`TMusic`.
*)
  TMusicTrackArray = array of TMusicTrack;

(*
## TMusic.SetupGameTab
```pascal
procedure TMusic.SetupGameTab();
```
Interal method used to setup the {ref}`TMusic` coordinates.

This is automatically called for you on the {ref}`Music variable`.
*)
procedure TMusic.SetupGameTab();
begin
  with GameTab.Bounds do
  begin
    Self.Scroll.Area.X1 := X1 + 5;
    Self.Scroll.Area.Y1 := Y1 + 59;
    Self.Scroll.Area.X2 := X2 - 21;
    Self.Scroll.Area.Y2 := Y2 - 19;

    Self.Buttons := TButtonArray.Create(
                        TBoxArray.Create([X1+61, Y1+7], 3, 1, 35, 24, [7, 0]),
                        [[$1D1F81, 0], [$181A6C, 0], [$1A1C74, 0], [$20238D, 0]]
                    );
  end;

  Self.Scroll.Setup();
end;

(*
## Music.IsOpen
```pascal
function TMusic.IsOpen(): Boolean;
```
Returns true if the music gametab is open.

Example:
```pascal
WriteLn Music.IsOpen();
```
*)
function TMusic.IsOpen() : Boolean;
begin
  Result := GameTabs.IsOpen(EGameTab.MUSIC);
end;

(*
## Music.Open
```pascal
function TMusic.Open(): Boolean;
```
Attempts to open the Music gametab.

Example:
```pascal
WriteLn Music.Open();
```
*)
function TMusic.Open() : Boolean;
begin
  Result := GameTabs.Open(EGameTab.MUSIC);
end;

(*
## Music.ActiveTrack
```pascal
property TMusic.ActiveTrack : String;
```
Returns the currently playing track.

Example:
```pascal
WriteLn Music.ActiveTrack;
```
*)
property TMusic.ActiveTrack : String;
begin
  if not Self.Open() then Exit;
  with GameTab.Bounds do
  begin
      Result := OCR.Recognize([X1, Y1 + 35, X2, Y1 + 51], Fonts.PLAIN_12, [TFonts.LIGHT_GREEN], 0);
  end;
end;

(*
## Music.GetTracks
```pascal
function TMusic.GetTracks() : TMusicTrackArray;
```
Returns the currently visible {ref}`TMusicTrackArray`.

Example:
```pascal
WriteLn Music.GetTracks();
```
*)
function TMusic.GetTracks() : TMusicTrackArray;
var
  tpa : TPointArray;
  atpa : T2DPointArray;
  track: TMusicTrack;
  weights: TIntegerArray;
begin
  if not Self.Open() then Exit;

  if Target.HasColor(TFonts.WHITE, 0, 1, Self.Scroll.Area) then
    Mouse.Move(Self.Scroll.Area.NearestEdge(Mouse.Position));

  tpa := Target.FindColor(TFonts.LIGHT_GREEN, 0, Self.Scroll.Area) + Target.FindColor(TFonts.RED, 0, Self.Scroll.Area);
  atpa := tpa.Cluster(10, 1.5);
  for tpa in atpa do
    with tpa.Bounds() do
    begin
      track.Name := OCR.Recognize([X1, Y1, X2, Y2], Fonts.PLAIN_12, [TFonts.LIGHT_GREEN, TFonts.RED], 0);

      if track.Name = '' then Continue;

      track.Available := Target.HasColor(TFonts.LIGHT_GREEN, 0, 1, [X1, Y1, X2, Y2]);
      track.Bounds := [X1, Y1, X2, Y2];

        weights += Y1;
        Result += track;
    end;

    Result.Sort(Weights, True);
end;

(*
## Music.FindTrack
```pascal
function TMusic.FindTrack(trackName: String) : TMusicTrack;
```
Returns a {ref}`TMusicTrack` if it was found in the playlist.

Example:
```pascal
var
  track: TMusicTrack;
begin
  track := Music.FindTrack('Sea Shanty 2');
  if track <> Default(TMusicTrack) then
    WriteLn track.Available;
end.
```
*)
function TMusic.FindTrack(trackName: String) : TMusicTrack;
var
  track: TMusicTrack;
  trackIndex: Integer;
  page: String;
  matchArray: TRegExprMatchArray;
  timeout: TCountDown;
begin
  if not Self.Open() then Exit;

  HTTPClient.Reset();
  page := HTTPClient.Get('https://oldschool.runescape.wiki/w/Music');
  matchArray := page.RegExprFindAll('data-music-track-name="(.*?)"');
  for trackIndex := 0 to High(matchArray) do
    if matchArray[trackIndex].Groups[0].Match.Equals(trackName, False) then
     Break;

  timeout.Start(10*SECOND);

  Self.Scroll.SetLevel(((trackIndex * 100) div high(matchArray))-1);

  repeat
    for track in Self.GetTracks() do
      if track.Name.Equals(trackName, false) then
        Exit(track);

    Self.Scroll.Scroll(1, true);
    Biometrics.Sleep(600);
  until timeout.IsFinished;
end;

(*
## Music.PlayTrack
```pascal
function TMusic.PlayTrack(trackName: String; force: Boolean = false) : Boolean;
```
Attempts to play the given track, if the track is already playing it can be clicked again by using the force parameter.
Returns true if successful.

Example:
```pascal
WriteLn Music.PlayTrack('Sea Shanty 2');
```
*)
function TMusic.PlayTrack(trackName: String; force: Boolean = false) : Boolean;
var
  track: TMusicTrack;
begin
  if not Self.Open() then Exit;
  if (Self.ActiveTrack.Equals(trackName, false) and not force) then Exit(True);

  track := Self.FindTrack(trackName);
  if track = Default(TMusicTrack) then Exit;
  if not track.Available then Exit;

  Mouse.Click(track.Bounds, EMouseButton.LEFT);
  Result := SleepUntil(Self.ActiveTrack.Equals(trackName, False), 250, 2000);
end;

(*
## Music variable
Global {ref}`TMusic` variable.
*)
var
  Music: TMusic;
